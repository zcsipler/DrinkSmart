    "For example %@ and %@ two hours later works out to %@ per hour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example %@ and %@ two hours later works out to %@ per hour."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Например %@ и %@ два часа по-късно дават %@ на час."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Například %@ a o dvě hodiny později %@ vychází na %@ za hodinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For eksempel giver %@ og %@ to timer senere %@ i timen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Beispiel: %@ und zwei Stunden später %@ ergibt %@ pro Stunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Για παράδειγμα %@ και %@ δύο ώρες αργότερα βγάζει %@ ανά ώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por ejemplo, %@ y %@ dos horas después dan %@ por hora."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Näiteks %@ ja %@ kaks tundi hiljem teeb %@ tunnis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esimerkiksi %@ ja %@ kaksi tuntia myöhemmin tarkoittaa %@ tunnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Par exemple, %@ puis %@ deux heures plus tard donne %@ par heure."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mar shampla, %@ agus ansin %@ dhá uair an chloig ina dhiaidh sin: sin %@ in aghaidh na huaire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na primjer, %@ i %@ dva sata poslije daje %@ na sat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Például %@, majd két órával később %@: ez %@ óránként."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per esempio %@ e %@ due ore dopo danno %@ all’ora."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pavyzdžiui, %@ ir %@ po dviejų valandų duoda %@ per valandą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Piemēram, %@ un %@ divas stundas vēlāk dod %@ stundā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ngħidu aħna, %@ u %@ sagħtejn wara jagħtu %@ fis-siegħa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bijvoorbeeld %@ en twee uur later %@ komt neer op %@ per uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na przykład %@ i %@ dwie godziny później daje %@ na godzinę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Por exemplo, %@ e %@ duas horas depois dão %@ por hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De exemplu, %@ și %@ două ore mai târziu înseamnă %@ pe oră."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Napríklad %@ a o dve hodiny neskôr %@ dáva %@ za hodinu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na primer %@ in %@ dve uri pozneje pomeni %@ na uro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Till exempel %@ och %@ två timmar senare blir %@ per timme."
          }
        }
      }
