    "How fast your liver clears alcohol once it has been absorbed — the slope of the falling side of the curve.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How fast your liver clears alcohol once it has been absorbed — the slope of the falling side of the curve."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Колко бързо черният ти дроб изчиства алкохола, след като той е усвоен — наклонът на спадащата част от кривата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak rychle tvá játra odbourávají alkohol, jakmile se vstřebá — sklon klesající části křivky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvor hurtigt din lever nedbryder alkohol, når den først er optaget — hældningen på kurvens faldende side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wie schnell deine Leber Alkohol abbaut, sobald er aufgenommen ist — die Steigung der fallenden Seite der Kurve."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Πόσο γρήγορα το συκώτι σου αποβάλλει το αλκοόλ αφού απορροφηθεί — η κλίση της κατιούσας πλευράς της καμπύλης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A qué velocidad elimina el alcohol tu hígado una vez absorbido: la pendiente de la parte descendente de la curva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kui kiiresti su maks alkoholi lagundab, kui see on juba imendunud — kõvera langeva poole kalle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kuinka nopeasti maksasi polttaa alkoholin sen imeydyttyä – käyrän laskevan puolen jyrkkyys."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À quelle vitesse ton foie élimine l'alcool une fois qu'il a été absorbé — la pente de la phase descendante de la courbe."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cé chomh tapa a ghlanann d'ae an t-alcól a luaithe atá sé ionsúite — fána an taoibh íslithigh den chuar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Koliko brzo tvoja jetra razgrađuje alkohol nakon što se apsorbira — nagib silazne strane krivulje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Milyen gyorsan üríti a májad a már felszívódott alkoholt — ez a görbe lecsengő szakaszának meredeksége."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quanto in fretta il fegato smaltisce l’alcol una volta assorbito: la pendenza del versante discendente della curva."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaip greitai tavo kepenys pašalina alkoholį po to, kai jis įsisavinamas, — krintančios kreivės dalies nuolydis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cik ātri tavas aknas izvada alkoholu pēc tā uzsūkšanās — līknes krītošās daļas slīpums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kemm malajr il-fwied tiegħek ineħħi l-alkoħol ladarba jkun ġie assorbit — ix-xaqliba tan-naħa niżla tal-kurva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoe snel je lever alcohol afbreekt zodra die is opgenomen — de helling van de dalende kant van de curve."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jak szybko twoja wątroba usuwa alkohol po jego wchłonięciu — nachylenie opadającej strony krzywej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com que rapidez o teu fígado elimina o álcool depois de absorvido — o declive da parte descendente da curva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cât de repede elimină ficatul tău alcoolul după ce a fost absorbit — panta părții descendente a curbei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ako rýchlo tvoja pečeň odbúrava alkohol po jeho vstrebaní — sklon klesajúcej časti krivky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kako hitro tvoja jetra izločijo alkohol, ko je ta absorbiran — naklon padajoče strani krivulje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hur snabbt levern bryter ner alkohol när den väl har tagits upp — lutningen på kurvans fallande sida."
          }
        }
      }
    },
