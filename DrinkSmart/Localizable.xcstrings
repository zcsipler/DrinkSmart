    "With slower metabolism yes, with faster no. That's the uncertainty of the estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With slower metabolism yes, with faster no. That's the uncertainty of the estimate."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При по-бавен метаболизъм — да, при по-бърз — не. Това е несигурността на оценката."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S pomalejším metabolismem ano, s rychlejším ne. To je nejistota odhadu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med en langsommere forbrænding ja, med en hurtigere nej. Det er skønnets usikkerhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei langsamerem Stoffwechsel ja, bei schnellerem nein. Das ist die Unsicherheit der Schätzung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Με πιο αργό μεταβολισμό ναι, με πιο γρήγορο όχι. Αυτή είναι η αβεβαιότητα της εκτίμησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con un metabolismo más lento sí, con uno más rápido no. Esa es la incertidumbre de la estimación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aeglasema ainevahetuse korral jah, kiirema korral ei. Selles ongi hinnangu ebakindlus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitaammalla aineenvaihdunnalla kyllä, nopeammalla ei. Se on arvion epävarmuus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avec un métabolisme plus lent, oui ; avec un plus rapide, non. C'est l'incertitude de l'estimation."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le meitibileacht níos moille, rachadh; le ceann níos tapúla, ní rachadh. Sin éiginnteacht an mheastacháin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uz sporiji metabolizam da, uz brži ne. To je neizvjesnost procjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lassabb lebontás esetén igen, a gyorsabbnál nem. Ez a becslés bizonytalansága."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con un metabolismo più lento sì, con uno più rapido no. È l’incertezza della stima."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esant lėtesnei medžiagų apykaitai — taip, esant greitesnei — ne. Toks yra šio įverčio neapibrėžtumas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ar lēnāku vielmaiņu — jā, ar ātrāku — nē. Tāda ir šī novērtējuma nenoteiktība."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "B'metaboliżmu aktar bil-mod iva, b'wieħed aktar mgħaġġel le. Dik hi l-inċertezza tal-istima."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bij een tragere stofwisseling wel, bij een snellere niet. Dat is de onzekerheid van de schatting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przy wolniejszym metabolizmie tak, przy szybszym nie. Na tym polega niepewność tego oszacowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com um metabolismo mais lento sim, com um mais rápido não. É essa a incerteza da estimativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cu un metabolism mai lent, da; cu unul mai rapid, nu. Aceasta este incertitudinea estimării."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri pomalšom metabolizme áno, pri rýchlejšom nie. To je neistota odhadu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri počasnejši presnovi da, pri hitrejši ne. To je negotovost ocene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med långsammare ämnesomsättning ja, med snabbare nej. Det är osäkerheten i uppskattningen."
          }
        }
      }
    },
