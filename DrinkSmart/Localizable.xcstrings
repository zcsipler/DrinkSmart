    "This is an estimate, not a measurement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an estimate, not a measurement."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това е оценка, а не измерване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tohle je odhad, ne měření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dette er et skøn, ikke en måling."
          }
        },
        "de": {
