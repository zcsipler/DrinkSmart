    "Nursed slowly. Much gentler climb for the same alcohol.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nursed slowly. Much gentler climb for the same alcohol."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изпита бавно. Много по-плавно покачване при същия алкохол."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Popíjeno pomalu. Při stejném množství alkoholu mnohem mírnější nárůst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drukket langsomt. Meget blidere stigning for den samme mængde alkohol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langsam getrunken. Deutlich sanfterer Anstieg bei gleicher Alkoholmenge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Πίνεται αργά. Πολύ πιο ήπια άνοδος για το ίδιο αλκοόλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bebida despacio. Subida mucho más suave con el mismo alcohol."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aeglaselt nauditud. Sama alkoholikoguse juures palju laugem tõus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Juotu hitaasti pitkän aikaa. Paljon loivempi nousu samalla alkoholimäärällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu lentement. Montée bien plus douce pour la même quantité d'alcool."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Á ól go mall. Ardú i bhfad níos míne don mhéid céanna alcóil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Polako ispijano. Mnogo blaži porast za istu količinu alkohola."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassan kortyolva. Ugyanannyi alkohol, sokkal szelídebb emelkedés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bevuto con calma. Salita molto più dolce a parità di alcol."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geriama lėtai. Tas pats alkoholio kiekis kyla daug švelniau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lēni izbaudīts. Daudz maigāks kāpums pie tāda paša alkohola daudzuma."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mixrub bil-mod. Tlugħ ħafna aktar ħafif għall-istess alkoħol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langzaam opgedronken. Veel vlakkere stijging bij dezelfde hoeveelheid alcohol."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pity powoli. Dużo łagodniejszy wzrost przy tej samej ilości alkoholu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bebida devagar. Subida muito mais suave para o mesmo álcool."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Băută încet. Creștere mult mai lină pentru aceeași cantitate de alcool."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Popíjané pomaly. Pri rovnakom množstve alkoholu oveľa miernejší nárast."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Počasi popita pijača. Precej blažji vzpon ob enaki količini alkohola."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drucken långsamt. Mycket mjukare stigning för samma mängd alkohol."
          }
        }
      }
    },
