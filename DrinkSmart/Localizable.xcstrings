    "Adds %@ occasions and %@ drinks. Nothing already here is changed or removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds %@ occasions and %@ drinks. Nothing already here is changed or removed."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ще добави сесии: %@, напитки: %@. Нищо, което вече е тук, не се променя и не се премахва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Přidá posezení (%@) a nápoje (%@). Nic, co už tu je, se nezmění ani neodstraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tilføjer %@ sessioner og %@ drinks. Intet af det, der allerede er her, ændres eller fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fügt %@ Sitzungen und %@ Getränke hinzu. Vorhandenes wird nicht geändert oder entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Προσθέτει %@ βραδιές και %@ ποτά. Τίποτα από όσα υπάρχουν ήδη δεν αλλάζει ούτε αφαιρείται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Añade %@ ocasiones y %@ bebidas. No se modifica ni se elimina nada de lo que ya hay aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisatavad joomiskorrad: %@, joogid: %@. Midagi siinolevast ei muudeta ega eemaldata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lisää %@ juomakertaa ja %@ juomaa. Mitään jo tallennettua ei muuteta eikä poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajoute %@ sessions et %@ verres. Rien de ce qui est déjà là n'est modifié ni supprimé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuirfidh sé seo %@ ócáid agus %@ deoch leis. Ní athrófar agus ní bhainfear aon rud atá anseo cheana."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaje — sesije: %@, pića: %@. Ništa što je već ovdje ne mijenja se niti uklanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáad %@ alkalmat és %@ italt. A meglévő adatok nem változnak és nem vesznek el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aggiunge %@ occasioni e %@ drink. Nulla di quanto è già qui viene modificato o rimosso."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bus pridėta sesijų: %@, gėrimų: %@. Niekas, kas jau yra, nebus pakeista ar pašalinta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiks pievienotas reizes: %@. Tiks pievienoti dzērieni: %@. Nekas no jau esošā netiek mainīts vai dzēsts."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okkażjonijiet li se jiżdiedu: %@. Xarbiet: %@. Xejn minn dak li diġà hawn ma jinbidel jew jitneħħa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voegt %@ gelegenheden en %@ drankjes toe. Er wordt niets veranderd of verwijderd wat er al staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodaje sesji: %@, drinków: %@. Nic z tego, co już tu jest, nie zostanie zmienione ani usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adiciona %@ ocasiões e %@ bebidas. Nada do que já está aqui é alterado ou removido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ocazii de adăugat: %@. Băuturi de adăugat: %@. Nimic din ce există deja nu este modificat sau șters."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Doplní: posedenia (%@), nápoje (%@). Nič, čo tu už je, sa nezmení ani neodstráni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dodani bodo dogodki: %@, pijače: %@. Nič od tega, kar je že tu, ne bo spremenjeno ali odstranjeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lägger till %@ tillfällen och %@ drycker. Inget som redan finns här ändras eller tas bort."
          }
        }
      }
    },
