    "Your own reference number, not a legal limit. The app tells you when a planned drink would take you past it, and for how long you would stay above.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own reference number, not a legal limit. The app tells you when a planned drink would take you past it, and for how long you would stay above."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Твоя собствена отправна стойност, а не законова граница. Приложението ти казва кога планирана напитка би те извела над нея и колко време ще останеш отгоре."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tvoje vlastní referenční číslo, ne zákonný limit. Aplikace ti řekne, kdy by tě plánovaný nápoj dostal nad něj a jak dlouho by hladina nad ním zůstala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit eget referencetal, ikke en lovbestemt grænse. Appen fortæller dig, hvornår en planlagt drink vil føre dig over den, og hvor længe du vil ligge over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine eigene Bezugsgröße, kein gesetzlicher Grenzwert. Die App sagt dir, wann ein geplantes Getränk dich darüber hinausbringen würde und wie lange du darüber bleiben würdest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ο δικός σου αριθμός αναφοράς, όχι νόμιμο όριο. Η εφαρμογή σού λέει πότε ένα ποτό που σχεδιάζεις θα σε περνούσε πάνω από αυτό και για πόση ώρα θα έμενες από πάνω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu propia cifra de referencia, no un límite legal. La app te avisa cuando una bebida prevista te haría superarlo y durante cuánto tiempo estarías por encima."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sinu enda võrdlusarv, mitte seaduslik piirmäär. Rakendus ütleb, kui kavandatud jook viiks sind sellest üle ja kui kaua sa sellest kõrgemal püsiksid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oma viitearvosi, ei laillinen raja. Sovellus kertoo, milloin suunniteltu juoma veisi sinut sen yli ja kuinka kauan pysyisit sen yläpuolella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ton propre repère, pas une limite légale. L'app t'indique quand un verre envisagé te ferait la dépasser, et pendant combien de temps tu resterais au-dessus."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "D'uimhir thagartha féin, ní teorainn dhlíthiúil. Insíonn an aip duit nuair a thabharfadh deoch bheartaithe thairsti thú, agus cé chomh fada a d'fhanfá os a cionn."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tvoj vlastiti orijentacijski broj, a ne zakonska granica. Aplikacija ti javlja kad bi te planirano piće odvelo preko nje i koliko dugo bi razina ostala iznad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te referenciaszámod, nem jogi limit. Az app jelzi, ha egy tervezett ital átvinne rajta — és azt is, mennyi ideig maradnál fölötte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un tuo valore di riferimento, non un limite legale. L’app ti dice quando un drink in programma te lo farebbe superare, e per quanto tempo resteresti sopra."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tai tavo paties orientacinis skaičius, o ne teisinė riba. Programėlė pasako, kada planuojamas gėrimas ją peržengtų ir kiek laiko liktum virš jos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tavs paša atskaites skaitlis, nevis likumā noteiktā robeža. Lietotne norāda, kad plānotais dzēriens to pārsniegtu un cik ilgi tu paliktu virs tās."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In-numru ta' referenza tiegħek stess, mhux limitu legali. L-app tgħidlek meta xarba ppjanata tieħdok lil hinn minnu, u għal kemm żmien tibqa' 'l fuq minnu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je eigen richtgetal, geen wettelijke limiet. De app vertelt je wanneer een gepland drankje je eroverheen zou brengen, en hoe lang je erboven zou blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoja własna liczba odniesienia, nie limit prawny. Aplikacja informuje, kiedy planowany drink przekroczyłby ten poziom i jak długo pozostaniesz powyżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um número de referência teu, não um limite legal. A app avisa-te quando uma bebida planeada te faria ultrapassá-lo, e durante quanto tempo ficarias acima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un reper stabilit de tine, nu o limită legală. Aplicația îți spune când o băutură planificată te-ar duce peste el și cât timp ai rămâne deasupra."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tvoje vlastné referenčné číslo, nie zákonný limit. Aplikácia ti povie, keď by ťa plánovaný nápoj dostal nad neho a ako dlho by si nad ním zostal."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tvoja lastna referenčna številka, ne zakonska meja. Aplikacija ti pove, kdaj bi te načrtovana pijača popeljala čeznjo in kako dolgo bi ostal nad njo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ditt eget referensvärde, inte en laglig gräns. Appen talar om när en planerad dryck skulle ta dig förbi den, och hur länge du skulle ligga över."
          }
        }
      }
    },
