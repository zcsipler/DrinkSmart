    "Slow absorption, lower and later peak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow absorption, lower and later peak."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бавно усвояване, по-нисък и по-късен пик."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pomalé vstřebávání, nižší a pozdější vrchol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langsom optagelse, lavere og senere top."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langsame Aufnahme, niedrigerer und späterer Höchstwert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Αργή απορρόφηση, χαμηλότερη και πιο όψιμη αιχμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absorción lenta, pico más bajo y más tardío."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aeglane imendumine, madalam ja hilisem tipp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hidas imeytyminen, matalampi ja myöhäisempi huippu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absorption lente, pic plus bas et plus tardif."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ionsú mall, buaic níos ísle agus níos déanaí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spora apsorpcija, niži i kasniji vrhunac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassú felszívódás, alacsonyabb és későbbi csúcs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assorbimento lento, picco più basso e più tardivo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lėta absorbcija, žemesnė ir vėlesnė viršūnė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lēna uzsūkšanās, zemāks un vēlāks maksimums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assorbiment bil-mod, quċċata aktar baxxa u aktar tard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Langzame opname, lagere en latere piek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Powolne wchłanianie, niższy i późniejszy szczyt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absorção lenta, pico mais baixo e mais tarde."
          }
        },
        "ro": {
