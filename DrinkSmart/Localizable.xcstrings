          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Negotovost"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osäkerhet"
          }
        }
      }
    },
    "Uncertainty is a matter of taste: it decides whether figures read as one number or as a range. The rate below is not — leave it to the frequency question unless you have a measurement to match it against.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncertainty is a matter of taste: it decides whether figures read as one number or as a range. The rate below is not — leave it to the frequency question unless you have a measurement to match it against."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Несигурността е въпрос на вкус: тя решава дали стойностите се четат като едно число, или като диапазон. Скоростта по-долу не е — остави я на въпроса за честотата, освен ако нямаш измерване, с което да я сверяваш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nejistota je věc vkusu: rozhoduje, jestli se údaje čtou jako jedno číslo, nebo jako rozpětí. Rychlost níže věc vkusu není — nech ji na otázce o frekvenci, pokud nemáš měření, se kterým by se dala srovnat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usikkerhed er en smagssag: den afgør, om tal vises som ét tal eller som et interval. Hastigheden nedenfor er ikke en smagssag — overlad den til spørgsmålet om frekvens, medmindre du har en måling at holde den op imod."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unsicherheit ist Geschmackssache: Sie entscheidet, ob Werte als eine Zahl oder als Bereich erscheinen. Die Rate darunter ist es nicht — überlass sie der Frage nach der Häufigkeit, außer du hast eine Messung, mit der du sie abgleichen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Η αβεβαιότητα είναι θέμα προτίμησης: καθορίζει αν οι τιμές διαβάζονται ως ένας αριθμός ή ως εύρος. Ο ρυθμός παρακάτω δεν είναι — άφησέ τον στην ερώτηση για τη συχνότητα, εκτός αν έχεις μια μέτρηση για να τον συγκρίνεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La incertidumbre es cuestión de gustos: decide si las cifras se leen como un número o como un rango. La tasa de abajo no lo es: déjasela a la pregunta sobre la frecuencia, salvo que tengas una medición con la que contrastarla."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ebakindlus on maitse asi: see otsustab, kas näite loetakse ühe arvuna või vahemikuna. Allpool olev kiirus ei ole maitse asi — jäta see sageduse küsimuse hooleks, kui sul pole mõõtmistulemust, millega seda kõrvutada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Epävarmuus on makuasia: se ratkaisee, näytetäänkö luvut yhtenä arvona vai vaihteluvälinä. Alla oleva nopeus ei ole makuasia – jätä se juomistiheyskysymyksen varaan, ellei sinulla ole mittausta, johon verrata sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'incertitude est affaire de goût : elle détermine si les valeurs se lisent comme un chiffre unique ou comme une fourchette. La vitesse ci-dessous, non — laisse-la à la question sur la fréquence, sauf si tu as une mesure à laquelle la comparer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Is ceist blais í an éiginnteacht: socraíonn sí an léitear figiúirí mar uimhir amháin nó mar raon. Ní hamhlaidh don ráta thíos — fág faoin gceist minicíochta é mura bhfuil tomhas agat le cur i gcomparáid leis."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neizvjesnost je stvar ukusa: određuje hoće li se brojke čitati kao jedan broj ili kao raspon. Brzina ispod nije — prepusti je pitanju o učestalosti, osim ako imaš mjerenje s kojim je možeš usporediti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bizonytalanság ízlés kérdése: ez dönti el, hogy a számok egy értékként vagy tartományként jelennek meg. Az alatta lévő sebesség nem az — hagyd a gyakorisági kérdésre, hacsak nincs mért értéked, amihez igazítanád."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’incertezza è una questione di gusto: decide se i valori si leggono come un numero solo o come un intervallo. La velocità qui sotto non lo è: lasciala alla domanda sulla frequenza, a meno che tu non abbia una misurazione con cui confrontarla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neapibrėžtumas yra skonio reikalas: jis lemia, ar reikšmės rodomos kaip vienas skaičius, ar kaip intervalas. Žemiau esantis greitis — ne; palik jį nustatyti pagal dažnio klausimą, nebent turi matavimą, su kuriuo gali jį palyginti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenoteiktība ir gaumes jautājums: tā nosaka, vai rādītāji tiek lasīti kā viens skaitlis vai kā diapazons. Ātrums zemāk tāds nav — atstāj to biežuma jautājuma ziņā, ja vien tev nav mērījuma, ar ko to salīdzināt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L-inċertezza hi kwistjoni ta' gost: tiddeċiedi jekk iċ-ċifri jinqrawx bħala numru wieħed jew bħala firxa. Ir-rata t'hawn taħt mhijiex — ħalliha f'idejn il-mistoqsija dwar il-frekwenza sakemm ma jkollokx kejl biex tqabbilha miegħu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onzekerheid is een kwestie van smaak: die bepaalt of cijfers als één getal of als een bereik worden gelezen. De snelheid hieronder is dat niet — laat die over aan de vraag over frequentie, tenzij je een meting hebt om hem aan te toetsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Niepewność to kwestia gustu: decyduje o tym, czy wartości czyta się jako jedną liczbę, czy jako zakres. Tempo poniżej kwestią gustu nie jest — zostaw je pytaniu o częstotliwość, chyba że masz pomiar, z którym możesz je porównać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A incerteza é uma questão de gosto: decide se os valores aparecem como um número ou como um intervalo. A taxa abaixo não é — deixa-a à pergunta da frequência, a não ser que tenhas uma medição com que a comparar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Incertitudinea ține de preferință: decide dacă valorile apar ca un singur număr sau ca un interval. Rata de mai jos nu ține de preferință — las-o pe seama întrebării despre frecvență, dacă nu ai o măsurătoare cu care să o compari."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neistota je vecou vkusu: rozhoduje o tom, či sa údaje čítajú ako jedno číslo alebo ako rozpätie. Rýchlosť nižšie vecou vkusu nie je — nechaj ju na otázku o frekvencii, pokiaľ nemáš meranie, s ktorým ju môžeš porovnať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Negotovost je stvar okusa: določa, ali so številke prikazane kot ena vrednost ali kot razpon. Spodnja hitrost ni stvar okusa — prepusti jo vprašanju o pogostosti, razen če imaš meritev, s katero jo lahko primerjaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Osäkerhet är en smaksak: den avgör om siffrorna läses som ett tal eller som ett intervall. Hastigheten nedanför är det inte — låt frågan om frekvens bestämma den, om du inte har en mätning att stämma av mot."
          }
        }
      }
    },
