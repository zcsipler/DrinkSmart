    "Logs it straight away, without opening anything.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs it straight away, without opening anything."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Записва я веднага, без да отваря нищо."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaznamená ho hned, bez otevírání čehokoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registrerer den med det samme, uden at åbne noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trägt es sofort ein, ohne dass sich etwas öffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το καταγράφει αμέσως, χωρίς να ανοίξει τίποτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La registra al instante, sin abrir nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Salvestab selle kohe, ilma midagi avamata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kirjaa sen heti avaamatta mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'enregistre immédiatement, sans rien ouvrir."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Logálann sé láithreach é, gan aon rud a oscailt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bilježi ga odmah, bez otvaranja ičega."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnal felviszi, mindenféle felugró nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo registra subito, senza aprire nulla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iš karto jį įrašo, nieko papildomai neatidarant."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pieraksta to uzreiz, neko neatverot."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jirreġistrah mill-ewwel, mingħajr ma jiftaħ xejn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legt het meteen vast, zonder iets te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapisuje go od razu, bez otwierania czegokolwiek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Regista-a de imediato, sem abrir nada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O înregistrează imediat, fără să deschidă nimic."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zaznamená ho okamžite, bez otvárania čohokoľvek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zabeleži jo takoj, brez odpiranja česar koli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loggar den direkt, utan att öppna något."
          }
        }
      }
    },
