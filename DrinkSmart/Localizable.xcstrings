    "Pick the drink you usually order, and a button on the Live screen will log it in one tap.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the drink you usually order, and a button on the Live screen will log it in one tap."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Избери напитката, която обикновено поръчваш, и бутон на екрана „На живо“ ще я записва с едно докосване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyber nápoj, který si dáváš nejčastěji, a tlačítko na obrazovce Aktuálně ho zaznamená jedním ťuknutím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vælg den drink, du plejer at bestille, så registrerer en knap på Live-skærmen den med ét tryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähl das Getränk, das du sonst bestellst, dann trägt eine Taste auf dem Live-Bildschirm es mit einem Tippen ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Διάλεξε το ποτό που συνήθως παραγγέλνεις και ένα κουμπί στην οθόνη «Ζωντανά» θα το καταγράφει με ένα πάτημα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige la bebida que sueles pedir y un botón en la pantalla En directo la registrará con un solo toque."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vali jook, mida tavaliselt tellid, ja Hetkeseisu ekraanil olev nupp salvestab selle ühe puudutusega."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valitse juoma, jonka yleensä tilaat, niin Live-näytön painike kirjaa sen yhdellä napautuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisis le verre que tu commandes d'habitude : un bouton sur l'écran Direct l'enregistrera en un seul appui."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Roghnaigh an deoch a ordaíonn tú de ghnáth, agus logálfaidh cnaipe ar an scáileán Beo í le tapáil amháin."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaberi piće koje obično naručuješ i gumb na zaslonu Uživo zabilježit će ga jednim dodirom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki, mit szoktál rendelni, és az Élő képernyőn egy gombnyomással felviheted."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli il drink che ordini di solito e un pulsante sulla schermata Live lo registrerà con un tocco."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pasirink gėrimą, kurį dažniausiai užsisakai, ir mygtukas ekrane „Tiesiogiai“ įrašys jį vienu bakstelėjimu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izvēlies dzērienu, ko parasti pasūti, un poga ekrānā Šobrīd to pierakstīs ar vienu pieskārienu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agħżel ix-xarba li normalment tordna, u buttuna fuq l-iskrin Dirett tirreġistraha b'daqqa waħda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kies het drankje dat je meestal bestelt, dan legt een knop op het Live-scherm het met één tik vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz drinka, który zwykle zamawiasz, a przycisk na ekranie Na żywo zapisze go jednym dotknięciem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolhe a bebida que costumas pedir e um botão no ecrã Em direto regista-a com um toque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alege băutura pe care o comanzi de obicei, iar un buton de pe ecranul Live o va înregistra dintr-o singură apăsare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vyber si nápoj, ktorý si zvyčajne dávaš, a tlačidlo na obrazovke Naživo ho zaznamená jedným ťuknutím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izberi pijačo, ki jo običajno naročiš, in gumb na zaslonu V živo jo bo zabeležil z enim dotikom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Välj drycken du brukar beställa, så loggar en knapp på Live-skärmen den med ett tryck."
          }
        }
      }
    },
