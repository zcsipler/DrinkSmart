    "Total body water comes from the Watson equations, which set the volume alcohol distributes into.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total body water comes from the Watson equations, which set the volume alcohol distributes into."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Общата телесна вода идва от уравненията на Watson, които определят обема, в който се разпределя алкохолът."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Celková tělesná voda vychází z Watsonových rovnic, které určují objem, do kterého se alkohol distribuuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samlet kropsvand kommer fra Watson-ligningerne, som fastsætter det volumen, alkohol fordeler sig i."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Gesamtkörperwasser stammt aus den Watson-Gleichungen, die das Volumen festlegen, in dem sich der Alkohol verteilt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το ολικό σωματικό νερό προκύπτει από τις εξισώσεις Watson, οι οποίες ορίζουν τον όγκο στον οποίο κατανέμεται το αλκοόλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El agua corporal total procede de las ecuaciones de Watson, que determinan el volumen en el que se distribuye el alcohol."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keha koguvesi tuleneb Watsoni võrranditest, mis määravad ruumala, millesse alkohol jaotub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kehon kokonaisvesimäärä lasketaan Watsonin yhtälöillä, jotka määrittävät tilavuuden, johon alkoholi jakautuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'eau corporelle totale vient des équations de Watson, qui déterminent le volume dans lequel l'alcool se répartit."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tagann uisce iomlán an choirp ó chothromóidí Watson, a shocraíonn an toirt ina ndáiltear an t-alcól."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukupna tjelesna voda proizlazi iz Watsonovih jednadžbi, koje određuju volumen u koji se alkohol raspoređuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes testvíz a Watson-formulákból jön, ez adja meg az alkohol eloszlási terét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’acqua corporea totale deriva dalle equazioni di Watson, che definiscono il volume in cui l’alcol si distribuisce."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bendras kūno vandens kiekis apskaičiuojamas pagal Watson lygtis, kurios nustato tūrį, kuriame pasiskirsto alkoholis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopējais ķermeņa ūdens tiek aprēķināts pēc Watson vienādojumiem, kas nosaka tilpumu, kurā alkohols izkliedējas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L-ilma totali tal-ġisem ġej mill-ekwazzjonijiet ta' Watson, li jiddeterminaw il-volum li fih jinfirex l-alkoħol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het totale lichaamswater komt uit de Watson-vergelijkingen, die het volume bepalen waarin alcohol zich verdeelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Całkowita woda ustrojowa pochodzi z równań Watsona, które wyznaczają objętość, w jakiej rozprowadza się alkohol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A água corporal total vem das equações de Watson, que definem o volume no qual o álcool se distribui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apa totală din organism provine din ecuațiile Watson, care stabilesc volumul în care se distribuie alcoolul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Celková telesná voda vychádza z Watsonových rovníc, ktoré určujú objem, v ktorom sa alkohol distribuuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skupna telesna voda izhaja iz Watsonovih enačb, ki določajo volumen, v katerega se alkohol porazdeli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Totalt kroppsvatten kommer från Watson-ekvationerna, som anger volymen som alkoholen fördelar sig i."
          }
        }
      }
    },
    "Total body water comes from the Watson equations, which set the volume alcohol distributes into. The female equation does not include age, so changing it will not affect the result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total body water comes from the Watson equations, which set the volume alcohol distributes into. The female equation does not include age, so changing it will not affect the result."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Общата телесна вода идва от уравненията на Watson, които определят обема, в който се разпределя алкохолът. Женското уравнение не включва възрастта, затова промяната ѝ няма да повлияе на резултата."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Celková tělesná voda vychází z Watsonových rovnic, které určují objem, do kterého se alkohol distribuuje. Ženská rovnice věk nezahrnuje, takže jeho změna výsledek neovlivní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Samlet kropsvand kommer fra Watson-ligningerne, som fastsætter det volumen, alkohol fordeler sig i. Ligningen for kvinder medregner ikke alder, så en ændring af den påvirker ikke resultatet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Gesamtkörperwasser stammt aus den Watson-Gleichungen, die das Volumen festlegen, in dem sich der Alkohol verteilt. Die Gleichung für Frauen enthält kein Alter, eine Änderung wirkt sich daher nicht auf das Ergebnis aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το ολικό σωματικό νερό προκύπτει από τις εξισώσεις Watson, οι οποίες ορίζουν τον όγκο στον οποίο κατανέμεται το αλκοόλ. Η εξίσωση για τις γυναίκες δεν περιλαμβάνει την ηλικία, οπότε η αλλαγή της δεν θα επηρεάσει το αποτέλεσμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El agua corporal total procede de las ecuaciones de Watson, que determinan el volumen en el que se distribuye el alcohol. La ecuación femenina no incluye la edad, así que cambiarla no afectará al resultado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keha koguvesi tuleneb Watsoni võrranditest, mis määravad ruumala, millesse alkohol jaotub. Naiste võrrand ei sisalda vanust, seega selle muutmine tulemust ei mõjuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kehon kokonaisvesimäärä lasketaan Watsonin yhtälöillä, jotka määrittävät tilavuuden, johon alkoholi jakautuu. Naisten yhtälö ei sisällä ikää, joten sen muuttaminen ei vaikuta tulokseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'eau corporelle totale vient des équations de Watson, qui déterminent le volume dans lequel l'alcool se répartit. L'équation féminine ne tient pas compte de l'âge : le modifier n'aura donc aucun effet sur le résultat."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tagann uisce iomlán an choirp ó chothromóidí Watson, a shocraíonn an toirt ina ndáiltear an t-alcól. Níl an aois san áireamh sa chothromóid do mhná, agus mar sin ní bheidh tionchar ag athrú uirthi ar an toradh."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukupna tjelesna voda proizlazi iz Watsonovih jednadžbi, koje određuju volumen u koji se alkohol raspoređuje. Ženska jednadžba ne uključuje dob, pa njezina promjena neće utjecati na rezultat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes testvíz a Watson-formulákból jön, ez adja meg az alkohol eloszlási terét. A női egyenlet nem tartalmazza az életkort, ezért annak állítása nem változtat az eredményen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’acqua corporea totale deriva dalle equazioni di Watson, che definiscono il volume in cui l’alcol si distribuisce. L’equazione femminile non include l’età, quindi modificarla non cambierà il risultato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bendras kūno vandens kiekis apskaičiuojamas pagal Watson lygtis, kurios nustato tūrį, kuriame pasiskirsto alkoholis. Moterų lygtyje amžius neįtraukiamas, todėl jo keitimas rezultato nepakeis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kopējais ķermeņa ūdens tiek aprēķināts pēc Watson vienādojumiem, kas nosaka tilpumu, kurā alkohols izkliedējas. Sieviešu vienādojumā vecums netiek izmantots, tāpēc tā maiņa rezultātu neietekmēs."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L-ilma totali tal-ġisem ġej mill-ekwazzjonijiet ta' Watson, li jiddeterminaw il-volum li fih jinfirex l-alkoħol. L-ekwazzjoni għan-nisa ma tinkludix l-età, għalhekk li tibdilha mhux se taffettwa r-riżultat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het totale lichaamswater komt uit de Watson-vergelijkingen, die het volume bepalen waarin alcohol zich verdeelt. De vergelijking voor vrouwen bevat geen leeftijd, dus die wijzigen heeft geen invloed op het resultaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Całkowita woda ustrojowa pochodzi z równań Watsona, które wyznaczają objętość, w jakiej rozprowadza się alkohol. Równanie dla kobiet nie uwzględnia wieku, więc jego zmiana nie wpłynie na wynik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A água corporal total vem das equações de Watson, que definem o volume no qual o álcool se distribui. A equação feminina não inclui a idade, por isso alterá-la não afeta o resultado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apa totală din organism provine din ecuațiile Watson, care stabilesc volumul în care se distribuie alcoolul. Ecuația pentru femei nu include vârsta, așa că modificarea ei nu va afecta rezultatul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Celková telesná voda vychádza z Watsonových rovníc, ktoré určujú objem, v ktorom sa alkohol distribuuje. Ženská rovnica nezahŕňa vek, takže jeho zmena výsledok neovplyvní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skupna telesna voda izhaja iz Watsonovih enačb, ki določajo volumen, v katerega se alkohol porazdeli. Ženska enačba ne vključuje starosti, zato njena sprememba ne bo vplivala na rezultat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Totalt kroppsvatten kommer från Watson-ekvationerna, som anger volymen som alkoholen fördelar sig i. Ekvationen för kvinnor innehåller inte ålder, så att ändra den påverkar inte resultatet."
          }
        }
      }
    },
