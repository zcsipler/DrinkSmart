    "A quick drink. The level climbs fast.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick drink. The level climbs fast."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бързо изпита напитка. Нивото се покачва бързо."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rychlé pití. Hladina stoupá rychle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En hurtig drink. Niveauet stiger hurtigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schnell getrunken. Der Alkoholspiegel steigt rasch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Γρήγορο ποτό. Το επίπεδο ανεβαίνει γρήγορα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una bebida rápida. El nivel sube deprisa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiire jook. Tase tõuseb kiiresti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nopea juoma. Taso nousee nopeasti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un verre bu vite. Le taux monte rapidement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deoch sciobtha. Ardaíonn an leibhéal go tapa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brzo popijeno piće. Razina raste brzo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors ital. A szint meredeken emelkedik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un drink veloce. Il livello sale in fretta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Greitai išgertas gėrimas. Lygis kyla sparčiai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ātri izdzerts. Līmenis strauji kāpj."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Xarba mgħaġġla. Il-livell jitla' malajr."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snel gedronken. Het niveau stijgt snel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szybki drink. Poziom rośnie szybko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma bebida rápida. O nível sobe depressa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O băutură consumată repede. Nivelul urcă rapid."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rýchlo vypitý nápoj. Hladina stúpa rýchlo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitro popita pijača. Raven hitro naraste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En snabb dryck. Nivån stiger snabbt."
          }
        }
      }
    },
    "A session appears here once it has ended — when your level has cleared and a few hours have passed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session appears here once it has ended — when your level has cleared and a few hours have passed."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сесията се появява тук, след като приключи — когато нивото ти се изчисти и минат няколко часа."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Posezení se sem přidá, jakmile skončí — až hladina klesne na nulu a uplyne několik hodin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En session vises her, når den er slut — når dit niveau er nede på nul, og der er gået et par timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Sitzung erscheint hier, sobald sie beendet ist — wenn dein Alkohol abgebaut ist und ein paar Stunden vergangen sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μια βραδιά εμφανίζεται εδώ μόλις ολοκληρωθεί — όταν το επίπεδό σου έχει μηδενιστεί και έχουν περάσει μερικές ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una sesión aparece aquí cuando ha terminado: cuando tu nivel se ha eliminado y han pasado unas horas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Joomiskord ilmub siia siis, kui see on lõppenud — kui su tase on kadunud ja paar tundi möödunud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Juomakerta ilmestyy tähän, kun se on päättynyt – kun tasosi on nollautunut ja muutama tunti on kulunut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une session apparaît ici une fois terminée — quand ton taux est redescendu à zéro et que quelques heures se sont écoulées."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Taispeántar seisiún anseo a luaithe atá deireadh leis — nuair atá do leibhéal glanta agus cúpla uair an chloig imithe thart."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesija se ovdje pojavljuje nakon što završi — kad ti razina padne na nulu i prođe nekoliko sati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy alkalom akkor kerül ide, ha lezárult — amikor a szinted kiürült, és eltelt néhány óra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una sessione compare qui quando è finita: quando hai smaltito l’alcol e sono passate alcune ore."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesija čia atsiranda jai pasibaigus — kai alkoholis išnyksta ir praeina kelios valandos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reize šeit parādās, kad tā ir beigusies — kad tavs līmenis ir nokrities līdz nullei un pagājušas dažas stundas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sessjoni tidher hawn ladarba tkun intemmet — meta l-livell tiegħek ikun għadda u jkunu għaddew ftit sigħat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een sessie verschijnt hier zodra hij is afgelopen — wanneer je niveau weer op nul staat en er een paar uur voorbij zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sesja pojawia się tutaj po zakończeniu — gdy twój poziom zejdzie do zera i minie kilka godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma sessão aparece aqui depois de terminar — quando o teu nível voltou a zero e passaram algumas horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O sesiune apare aici după ce s-a încheiat — când alcoolul s-a eliminat complet și au trecut câteva ore."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Posedenie sa tu objaví, keď sa skončí — keď alkohol vyprchá a uplynie niekoľko hodín."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dogodek se prikaže tukaj, ko se konča — ko se alkohol izloči in mine nekaj ur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ett tillfälle dyker upp här när det har avslutats — när din nivå har nått noll och några timmar har gått."
          }
        }
      }
    },
    "A single number is easier to learn against: over time you find out what your own 0.6 feels like. A range is the more literal answer, because the rate really is uncertain. Both are defensible — this is your call.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single number is easier to learn against: over time you find out what your own 0.6 feels like. A range is the more literal answer, because the rate really is uncertain. Both are defensible — this is your call."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "С едно число се учиш по-лесно: с времето разбираш как се усещат твоите собствени 0,6. Диапазонът е по-буквалният отговор, защото скоростта наистина е несигурна. И двете са защитими — решението е твое."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podle jednoho čísla se to učí snáz: časem zjistíš, jak se u tebe projevuje 0,6. Rozpětí je doslovnější odpověď, protože rychlost je opravdu nejistá. Obojí se dá obhájit — rozhodnutí je na tobě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Et enkelt tal er nemmere at lære af: med tiden finder du ud af, hvordan din egen 0,6 føles. Et interval er det mere bogstavelige svar, for hastigheden er reelt usikker. Begge dele kan forsvares — det er dit valg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "An einer einzelnen Zahl lässt sich leichter lernen: Mit der Zeit findest du heraus, wie sich deine eigenen 0,6 anfühlen. Ein Bereich ist die ehrlichere Antwort, denn die Abbaurate ist tatsächlich unsicher. Beides lässt sich vertreten — das ist deine Entscheidung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Με έναν μόνο αριθμό μαθαίνεις πιο εύκολα: με τον καιρό ανακαλύπτεις πώς νιώθεις στο δικό σου 0,6. Το εύρος είναι η πιο κυριολεκτική απάντηση, γιατί ο ρυθμός είναι όντως αβέβαιος. Και τα δύο στέκουν — η επιλογή είναι δική σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con un solo número es más fácil aprender: con el tiempo descubres cómo se siente tu propio 0,6. Un rango es la respuesta más literal, porque la tasa es realmente incierta. Ambas opciones son defendibles; la decisión es tuya."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Üksiku arvu järgi on lihtsam õppida: aja jooksul saad teada, milline tundub sinu enda 0,6. Vahemik on otsesem vastus, sest kiirus ongi ebakindel. Mõlemad on põhjendatud — see on sinu valik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yhteen lukuun on helpompi oppia suhtautumaan: ajan myötä huomaat, miltä oma 0,6 tuntuu. Vaihteluväli on kirjaimellisempi vastaus, koska palamisnopeus on todella epävarma. Molemmat ovat perusteltuja – valinta on sinun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un chiffre unique est plus facile à apprivoiser : avec le temps, tu découvres ce que représente ton propre 0,6. Une fourchette est la réponse la plus littérale, car la vitesse d'élimination est réellement incertaine. Les deux se défendent — à toi de choisir."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Is fusa foghlaim ó uimhir amháin: le himeacht ama tuigfidh tú cén chaoi a mbraitheann do 0.6 féin. Is é an raon an freagra is litriúla, mar tá an ráta éiginnte go deimhin. Tá an dá rud inchosanta — is fútsa atá sé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jedan broj je lakše naučiti: s vremenom otkriješ kako se osjećaš na svojih 0,6. Raspon je doslovniji odgovor, jer je brzina doista neizvjesna. Oboje je opravdano — odluka je tvoja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen számhoz könnyebb tanulni: idővel megtudod, nálad mit jelent a 0,6. A tartomány a szó szerintibb válasz, mert a lebontási sebesség tényleg bizonytalan. Mindkettő védhető — ez a te döntésed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su un numero singolo è più facile farsi l’occhio: col tempo scopri come ti senti al tuo 0,6. Un intervallo è la risposta più fedele, perché la velocità è davvero incerta. Entrambe le scelte sono valide: decidi tu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iš vieno skaičiaus lengviau mokytis: laikui bėgant sužinai, kaip jautiesi, kai tavo lygis yra 0,6. Intervalas yra tikslesnis atsakymas, nes greitis iš tiesų nėra tiksliai žinomas. Abu variantai pagrįsti — spręsk pats."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pēc viena skaitļa ir vieglāk mācīties: laika gaitā tu uzzini, kā jūties tieši pie savām 0,6. Diapazons ir burtiskāka atbilde, jo ātrums tiešām ir nenoteikts. Abi varianti ir pamatoti — izvēle ir tava."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Numru wieħed hu eħfef biex titgħallem miegħu: maż-żmien issir taf kif tħossok bi 0.6 tiegħek. Firxa hi t-tweġiba aktar letterali, għax ir-rata tassew mhijiex ċerta. It-tnejn jistgħu jiġu difiżi — id-deċiżjoni hi tiegħek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tegen één getal leer je jezelf makkelijker afzetten: na verloop van tijd weet je hoe jouw eigen 0,6 voelt. Een bereik is het letterlijkere antwoord, want de snelheid is werkelijk onzeker. Beide zijn te verdedigen — dit is jouw keuze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pojedyncza liczba jest łatwiejszym punktem odniesienia: z czasem dowiesz się, jak się czujesz przy swoim własnym 0,6. Zakres to odpowiedź bardziej dosłowna, bo tempo naprawdę jest niepewne. Oba podejścia da się obronić — to twoja decyzja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um número único é mais fácil de interiorizar: com o tempo, descobres o que o teu próprio 0,6 significa para ti. Um intervalo é a resposta mais literal, porque a taxa é mesmo incerta. Ambos se defendem — a escolha é tua."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un singur număr e mai ușor de folosit ca reper: cu timpul afli cum se simte propriul tău 0,6. Un interval e răspunsul mai fidel realității, pentru că rata chiar este incertă. Ambele variante se susțin — tu decizi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jediné číslo sa lepšie učí: časom zistíš, ako sa cítiš pri svojich 0,6. Rozpätie je doslovnejšia odpoveď, pretože rýchlosť je naozaj neistá. Oboje sa dá obhájiť — rozhodnutie je na tebe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ob eni sami številki se je lažje učiti: sčasoma spoznaš, kakšen občutek je pri tvojih 0,6. Razpon je bolj dobesedni odgovor, ker je hitrost res negotova. Oboje je utemeljeno — odločitev je tvoja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ett enda tal är lättare att lära sig av: med tiden får du reda på hur din egen 0,6 känns. Ett intervall är det mer bokstavliga svaret, eftersom hastigheten verkligen är osäker. Båda går att försvara — det här är ditt val."
          }
        }
      }
    },
    "Actual values vary considerably between individuals. Never use this to decide whether you can drive.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual values vary considerably between individuals. Never use this to decide whether you can drive."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Действителните стойности се различават значително при отделните хора. Никога не използвай това, за да решиш дали можеш да шофираш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skutečné hodnoty se mezi lidmi výrazně liší. Nikdy podle toho nerozhoduj, jestli můžeš řídit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De faktiske værdier varierer betydeligt fra person til person. Brug aldrig dette til at afgøre, om du kan køre bil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die tatsächlichen Werte schwanken erheblich von Person zu Person. Entscheide damit nie, ob du fahren kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Οι πραγματικές τιμές διαφέρουν σημαντικά από άτομο σε άτομο. Μη χρησιμοποιείς ποτέ αυτό για να αποφασίσεις αν μπορείς να οδηγήσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los valores reales varían considerablemente de una persona a otra. No uses nunca esto para decidir si puedes conducir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tegelikud väärtused erinevad inimeseti märgatavalt. Ära kunagi kasuta seda otsustamaks, kas võid autot juhtida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todelliset arvot vaihtelevat huomattavasti yksilöiden välillä. Älä koskaan käytä tätä sen ratkaisemiseen, voitko ajaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les valeurs réelles varient considérablement d'une personne à l'autre. Ne t'en sers jamais pour décider si tu peux conduire."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Athraíonn na fíorluachanna go mór ó dhuine go duine. Ná bain úsáid as seo choíche le cinneadh a dhéanamh an féidir leat tiomáint."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stvarne vrijednosti znatno se razlikuju od osobe do osobe. Nikad ne koristi ovo za procjenu smiješ li voziti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tényleges érték egyénenként jelentősen eltérhet. Soha ne használd annak eldöntésére, hogy vezethetsz-e."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I valori reali variano molto da persona a persona. Non usare mai questo dato per decidere se puoi guidare."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tikrosios reikšmės tarp žmonių labai skiriasi. Niekada nesiremk tuo spręsdamas, ar gali vairuoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faktiskās vērtības dažādiem cilvēkiem ievērojami atšķiras. Nekad neizmanto to, lai izlemtu, vai drīksti braukt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il-valuri reali jvarjaw ħafna minn persuna għal oħra. Qatt tuża dan biex tiddeċiedi jekk tistax issuq."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De werkelijke waarden verschillen sterk van persoon tot persoon. Gebruik dit nooit om te bepalen of je kunt rijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rzeczywiste wartości różnią się znacznie między osobami. Nigdy nie używaj tego do oceny, czy możesz prowadzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os valores reais variam consideravelmente de pessoa para pessoa. Nunca uses isto para decidir se podes conduzir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valorile reale variază considerabil de la o persoană la alta. Nu folosi niciodată acest lucru pentru a decide dacă poți conduce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skutočné hodnoty sa medzi ľuďmi výrazne líšia. Nikdy podľa toho nerozhoduj o tom, či môžeš šoférovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dejanske vrednosti se med posamezniki precej razlikujejo. Tega nikoli ne uporabljaj za odločitev, ali lahko voziš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faktiska värden varierar kraftigt mellan individer. Använd aldrig det här för att avgöra om du kan köra bil."
          }
        }
      }
    },
