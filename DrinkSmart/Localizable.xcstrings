    "Fast absorption, higher and earlier peak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast absorption, higher and earlier peak."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Бързо усвояване, по-висок и по-ранен пик."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rychlé vstřebávání, vyšší a dřívější vrchol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hurtig optagelse, højere og tidligere top."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schnelle Aufnahme, höherer und früherer Höchstwert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Γρήγορη απορρόφηση, υψηλότερη και πιο πρώιμη αιχμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absorción rápida, pico más alto y más temprano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiire imendumine, kõrgem ja varasem tipp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nopea imeytyminen, korkeampi ja aikaisempi huippu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absorption rapide, pic plus haut et plus précoce."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ionsú tapa, buaic níos airde agus níos luaithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brza apsorpcija, viši i raniji vrhunac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors felszívódás, magasabb és korábbi csúcs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assorbimento rapido, picco più alto e più precoce."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Greita absorbcija, aukštesnė ir ankstesnė viršūnė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ātra uzsūkšanās, augstāks un agrāks maksimums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Assorbiment mgħaġġel, quċċata ogħla u aktar kmieni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snelle opname, hogere en vroegere piek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Szybkie wchłanianie, wyższy i wcześniejszy szczyt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absorção rápida, pico mais alto e mais cedo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Absorbție rapidă, vârf mai ridicat și mai devreme."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rýchle vstrebávanie, vyšší a skorší vrchol."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hitra absorpcija, višji in zgodnejši vrh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Snabbt upptag, högre och tidigare topp."
          }
        }
      }
    },
