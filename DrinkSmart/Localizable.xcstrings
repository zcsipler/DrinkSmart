    "Weeks, months and years side by side — and every evening older than seven days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weeks, months and years side by side — and every evening older than seven days."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Седмици, месеци и години една до друга – и всяка вечер, по-стара от седем дни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Týdny, měsíce a roky vedle sebe – a každý večer starší než sedm dní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uger, måneder og år side om side – og hver aften ældre end syv dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wochen, Monate und Jahre nebeneinander – und jeder Abend, der älter als sieben Tage ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Εβδομάδες, μήνες και χρόνια το ένα δίπλα στο άλλο – και κάθε βραδιά παλαιότερη από επτά ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semanas, meses y años uno junto a otro, y cada noche de hace más de siete días."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nädalad, kuud ja aastad kõrvuti – ja iga üle seitsme päeva vanune õhtu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viikot, kuukaudet ja vuodet rinnakkain – ja jokainen yli seitsemän päivää vanha ilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semaines, mois et années côte à côte – et chaque soirée de plus de sept jours."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seachtainí, míonna agus blianta taobh le taobh – agus gach oíche níos sine ná seacht lá."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tjedni, mjeseci i godine jedni uz druge – i svaka večer starija od sedam dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetek, hónapok és évek egymás mellett – és minden hét napnál régebbi este."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Settimane, mesi e anni affiancati, e ogni serata più vecchia di sette giorni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Savaitės, mėnesiai ir metai vienas šalia kito – ir kiekvienas vakaras, senesnis nei septynios dienos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nedēļas, mēneši un gadi blakus – un katrs vakars, vecāks par septiņām dienām."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ġimgħat, xhur u snin ħdejn xulxin – u kull lejla eqdem minn sebat ijiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weken, maanden en jaren naast elkaar – en elke avond ouder dan zeven dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tygodnie, miesiące i lata obok siebie – oraz każdy wieczór starszy niż siedem dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Semanas, meses e anos lado a lado – e cada noite com mais de sete dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Săptămâni, luni și ani unul lângă altul – și fiecare seară mai veche de șapte zile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Týždne, mesiace a roky vedľa seba – a každý večer starší ako sedem dní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tedni, meseci in leta drug ob drugem – in vsak večer, starejši od sedmih dni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veckor, månader och år sida vid sida – och varje kväll äldre än sju dagar."
          }
        }
      }
    },
