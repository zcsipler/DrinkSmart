    "Counts as a single swallow — the steepest possible rise.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts as a single swallow — the steepest possible rise."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Брои се като една глътка — възможно най-стръмното покачване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Počítá se jako jeden doušek — nejstrmější možný nárůst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tæller som en enkelt slurk — den stejlest mulige stigning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zählt als ein einziger Schluck — der steilstmögliche Anstieg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μετράει ως μία γουλιά — η πιο απότομη δυνατή άνοδος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuenta como un solo trago: la subida más rápida posible."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Loeb üheks sõõmuks — järsim võimalik tõus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lasketaan yhdeksi kulaukseksi – jyrkin mahdollinen nousu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compte comme une seule gorgée — la montée la plus raide possible."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Áirítear é mar bholgam amháin — an t-ardú is géire is féidir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Računa se kao jedan gutljaj — najstrmiji mogući porast."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen kortynak számít — ez a lehető legmeredekebb emelkedés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conta come un solo sorso: la salita più ripida possibile."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skaičiuojama kaip vienas gurkšnis — sparčiausias įmanomas kilimas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiek uzskatīts par vienu malku — visstraujākais iespējamais kāpums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jgħodd bħala belgħa waħda — l-aktar tlugħ qawwi possibbli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telt als één slok — de steilst mogelijke stijging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Liczy się jako jeden łyk — najbardziej stromy możliwy wzrost."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Conta como um único gole — a subida mais acentuada possível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se consideră o singură înghițitură — cea mai abruptă creștere posibilă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Počíta sa ako jeden dúšok — najstrmší možný nárast."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šteje kot en sam požirek — najstrmejši možni vzpon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Räknas som en enda klunk — den brantaste möjliga stigningen."
          }
        }
      }
    },
