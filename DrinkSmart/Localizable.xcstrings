        }
      }
    },
    "Their own limit and the finer settings can be changed later on the Profile tab, while they are the selected person.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their own limit and the finer settings can be changed later on the Profile tab, while they are the selected person."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Собственият им лимит и по-фините настройки могат да се променят по-късно в раздела „Профил“, докато този човек е избран."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vlastní limit a jemnější nastavení se dají změnit později na kartě Profil, když je tato osoba vybraná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deres egen grænse og de finere indstillinger kan ændres senere under fanen Profil, mens de er den valgte person."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das eigene Limit und die feineren Einstellungen lassen sich später im Tab „Profil“ ändern, solange die Person ausgewählt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το δικό τους όριο και οι λεπτομερέστερες ρυθμίσεις μπορούν να αλλάξουν αργότερα στην καρτέλα «Προφίλ», όσο είναι το επιλεγμένο άτομο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su propio límite y los ajustes más detallados se pueden cambiar después en la pestaña Perfil, mientras sea la persona seleccionada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tema enda piiri ja peenemaid seadeid saab hiljem muuta Profiili vahekaardil, kui tema on valitud inimene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hänen oman rajansa ja tarkemmat asetuksensa voi muuttaa myöhemmin Profiili-välilehdellä silloin, kun hän on valittuna henkilönä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sa limite personnelle et les réglages plus fins pourront être modifiés plus tard dans l'onglet Profil, lorsqu'elle est la personne sélectionnée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Is féidir a dteorainn féin agus na socruithe míne a athrú níos déanaí ar an gcluaisín Próifíl, fad is iad an duine roghnaithe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vlastitu granicu i finije postavke možeš promijeniti poslije na kartici Profil, dok je ta osoba odabrana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A saját határ és a finomabb beállítások később a Profil fülön módosíthatók, amíg ő a kiválasztott személy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il suo limite e le impostazioni più fini si possono cambiare in seguito nella scheda Profilo, mentre è la persona selezionata."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jo asmeninę ribą ir smulkesnius nustatymus vėliau gali pakeisti skiltyje „Profilis“, kai jis yra pasirinktas žmogus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viņu pašu robežu un smalkākos iestatījumus vēlāk var mainīt cilnē Profils, kamēr viņi ir izvēlētā persona."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il-limitu tagħhom u l-issettjar aktar dettaljat jistgħu jinbidlu aktar tard fit-tab Profil, waqt li huma l-persuna magħżula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hun eigen limiet en de fijnere instellingen kun je later aanpassen op het tabblad Profiel, zolang zij de geselecteerde persoon zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Własny limit tej osoby i dokładniejsze ustawienia można zmienić później na karcie Profil, gdy ta osoba jest wybrana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O limite próprio e as definições mais detalhadas podem ser alterados depois no separador Perfil, enquanto esta for a pessoa selecionada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Limita proprie și setările mai fine pot fi modificate ulterior în fila Profil, cât timp este persoana selectată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vlastný limit a jemnejšie nastavenia sa dajú zmeniť neskôr na karte Profil, keď je táto osoba vybraná."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lastno mejo te osebe in podrobnejše nastavitve lahko pozneje spremeniš v zavihku Profil, ko je ta oseba izbrana."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deras egen gräns och de finare inställningarna kan ändras senare under fliken Profil, när de är den valda personen."
          }
        }
      }
    },
    "This backup was made by a newer version of DrinkSmart. Update the app and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made by a newer version of DrinkSmart. Update the app and try again."
          }
        },
        "bg": {
          "stringUnit": {
