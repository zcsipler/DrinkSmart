    "The Widmark factor is typically around 0.68 for men and 0.55 for women. If yours is far from that, it is worth checking the values above.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Widmark factor is typically around 0.68 for men and 0.55 for women. If yours is far from that, it is worth checking the values above."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Widmark-faktor tipikusan 0,68 körül van férfiaknál és 0,55 körül nőknél. Ha a tiéd messze esik ettől, érdemes ellenőrizni a fenti adatokat."
          }
        }
      }
    },
    "This is an estimate, not a measurement.": {
      "extractionState": "manual",
