    "Everything you have logged is already saved. Unlocking only shows it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you have logged is already saved. Unlocking only shows it."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Всичко, което си записал, вече е запазено. Отключването само го показва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vše, co jste zaznamenali, je už uloženo. Odemknutí to jen zobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alt, du har registreret, er allerede gemt. At låse op viser det blot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles, was du bisher eingetragen hast, ist bereits gespeichert. Das Freischalten zeigt es nur an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Όλα όσα έχετε καταγράψει είναι ήδη αποθηκευμένα. Το ξεκλείδωμα απλώς τα εμφανίζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todo lo que has registrado ya está guardado. Desbloquear solo lo muestra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kõik, mille oled kirja pannud, on juba salvestatud. Avamine ainult näitab seda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaikki kirjaamasi on jo tallennettu. Avaaminen vain näyttää sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tout ce que vous avez saisi est déjà enregistré. Le déverrouillage ne fait que l’afficher."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tá gach rud a logáil tú sábháilte cheana féin. Ní dhéanann an díghlasáil ach é a thaispeáint."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sve što si zabilježio već je spremljeno. Otključavanje to samo prikazuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit eddig felvittél, már el van mentve. A feloldás csak megmutatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutto ciò che hai registrato è già salvato. Sbloccare serve solo a mostrarlo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viskas, ką įrašėte, jau išsaugota. Atrakinimas tik tai parodo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viss, ko esi ierakstījis, jau ir saglabāts. Atbloķēšana to tikai parāda."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kulma rreġistrajt huwa diġà salvat. L-iftuħ juri biss dan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alles wat je hebt ingevoerd is al opgeslagen. Ontgrendelen laat het alleen zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wszystko, co zapisałeś, jest już zachowane. Odblokowanie tylko to pokazuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tudo o que registou já está guardado. Desbloquear apenas o mostra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tot ce ai înregistrat este deja salvat. Deblocarea doar îl afișează."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Všetko, čo ste zaznamenali, je už uložené. Odomknutie to len zobrazí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vse, kar si zabeležil, je že shranjeno. Odklep to le pokaže."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allt du har loggat är redan sparat. Att låsa upp visar det bara."
          }
        }
      }
    },
