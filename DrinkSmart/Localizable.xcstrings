    "At this setting, %@ takes about %@ to clear. Almost everyone falls between %@ per hour.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this setting, %@ takes about %@ to clear. Almost everyone falls between %@ per hour."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При тази настройка %@ се изчиства за около %@. Почти всички попадат между %@ на час."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Při tomto nastavení se %@ odbourá přibližně za %@. Téměř všichni se pohybují mezi %@ za hodinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ved denne indstilling tager %@ omkring %@ at nedbryde. Næsten alle ligger mellem %@ i timen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei dieser Einstellung braucht %@ etwa %@ bis zum Abbau. Fast alle liegen zwischen %@ pro Stunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Με αυτή τη ρύθμιση, %@ χρειάζεται περίπου %@ για να μηδενιστεί. Σχεδόν όλοι βρίσκονται μεταξύ %@ ανά ώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con este ajuste, %@ tarda aproximadamente %@ en eliminarse. Casi todo el mundo está entre %@ por hora."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selle seade juures kulub %@ kadumiseks umbes %@. Peaaegu kõik jäävad vahemikku %@ tunnis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tällä asetuksella %@ nollautuu noin ajassa %@. Lähes kaikki osuvat välille %@ tunnissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avec ce réglage, %@ met environ %@ à redescendre à zéro. Presque tout le monde se situe entre %@ par heure."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leis an socrú seo, glanann %@ i gceann thart ar %@. Titeann beagnach gach duine idir %@ in aghaidh na huaire."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri ovoj postavci %@ pada na nulu za otprilike %@. Gotovo svi su između %@ na sat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel a beállítással %@ körülbelül %@ alatt ürül ki. Szinte mindenkinél %@ közé esik ez az érték óránként."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Con questa impostazione, per smaltire %@ servono circa %@. Quasi tutti rientrano tra %@ all’ora."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esant šiam nustatymui, %@ išnyksta maždaug per %@. Beveik visi patenka į intervalą %@ per valandą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ar šo iestatījumu %@ izvadīšana aizņem aptuveni %@. Gandrīz visiem tas ir diapazonā %@ stundā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "B'dan l-issettjar, %@ jieħu madwar %@ biex jgħaddi. Kważi kulħadd jaqa' bejn %@ fis-siegħa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Met deze instelling duurt het bij %@ ongeveer %@ voordat je weer op nul bent. Bijna iedereen zit tussen %@ per uur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przy tym ustawieniu %@ schodzi do zera w około %@. Prawie wszyscy mieszczą się w przedziale %@ na godzinę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Com esta definição, %@ demora cerca de %@ a voltar a zero. Quase toda a gente fica entre %@ por hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La această setare, %@ se elimină în aproximativ %@. Aproape toată lumea se încadrează între %@ pe oră."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri tomto nastavení %@ vyprchá asi za %@. Takmer všetci sa pohybujú medzi %@ za hodinu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri tej nastavitvi se %@ izloči v približno %@. Skoraj vsi so v razponu %@ na uro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med den här inställningen tar %@ ungefär %@ att nå noll. Nästan alla ligger mellan %@ per timme."
          }
        }
      }
    },
    "At zero every figure is a single number — the app's best estimate. Above zero the same figures are shown as ranges, and the band on the chart widens to match.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At zero every figure is a single number — the app's best estimate. Above zero the same figures are shown as ranges, and the band on the chart widens to match."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При нула всяка стойност е едно число — най-добрата преценка на приложението. Над нула същите стойности се показват като диапазони, а лентата на графиката се разширява съответно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na nule je každý údaj jedno číslo — nejlepší odhad aplikace. Nad nulou se tytéž údaje zobrazují jako rozpětí a pás v grafu se tomu přizpůsobí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ved nul er hvert tal et enkelt tal — appens bedste skøn. Over nul vises de samme tal som intervaller, og båndet på grafen bliver tilsvarende bredere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bei null ist jeder Wert eine einzelne Zahl — die beste Schätzung der App. Über null werden dieselben Werte als Bereiche angezeigt, und das Band im Diagramm wird entsprechend breiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Στο μηδέν κάθε τιμή είναι ένας μόνο αριθμός — η καλύτερη εκτίμηση της εφαρμογής. Πάνω από το μηδέν οι ίδιες τιμές εμφανίζονται ως εύρη και η ζώνη στο γράφημα πλαταίνει ανάλογα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En cero, cada cifra es un solo número: la mejor estimación de la app. Por encima de cero, las mismas cifras se muestran como rangos, y la banda del gráfico se ensancha en consecuencia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nulli juures on iga näit üks arv — rakenduse parim hinnang. Nullist ülalpool näidatakse samu näite vahemikena ja graafiku riba laieneb vastavalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nollassa jokainen luku on yksi arvo – sovelluksen paras arvio. Nollan yläpuolella samat luvut näytetään vaihteluväleinä, ja kuvaajan vyöhyke levenee vastaavasti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "À zéro, chaque valeur est un chiffre unique — la meilleure estimation de l'app. Au-dessus de zéro, les mêmes valeurs sont affichées sous forme de fourchettes, et la bande du graphique s'élargit en conséquence."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ag nialas is uimhir aonair gach figiúr — an meastachán is fearr atá ag an aip. Os cionn nialais taispeántar na figiúirí céanna mar raonta, agus leathnaíonn an banda ar an gcairt dá réir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Na nuli je svaka brojka jedan broj — najbolja procjena aplikacije. Iznad nule iste se brojke prikazuju kao rasponi, a pojas na grafikonu proširuje se u skladu s tim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nullán minden szám egyetlen érték — az app legjobb becslése. Nulla fölött ugyanezek tartományként jelennek meg, és a grafikon sávja is ennek megfelelően szélesedik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A zero ogni valore è un numero singolo: la stima migliore dell’app. Sopra lo zero gli stessi valori sono mostrati come intervalli, e la banda sul grafico si allarga di conseguenza."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ties nuliu kiekviena reikšmė rodoma kaip vienas skaičius — geriausias programėlės įvertis. Virš nulio tos pačios reikšmės rodomos kaip intervalai, o juosta diagramoje atitinkamai praplatėja."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pie nulles katrs rādītājs ir viens skaitlis — lietotnes labākais novērtējums. Virs nulles tie paši rādītāji tiek rādīti kā diapazoni, un josla diagrammā attiecīgi paplašinās."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fuq żero kull ċifra hi numru wieħed — l-aħjar stima tal-app. 'Il fuq minn żero l-istess ċifri jintwerew bħala firxiet, u l-faxxa fuq il-graff titwessa' biex taqbel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Op nul is elk cijfer één getal — de beste schatting van de app. Boven nul worden dezelfde cijfers als bereiken getoond, en de band op de grafiek wordt navenant breder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przy zerze każda wartość to pojedyncza liczba — najlepsze oszacowanie aplikacji. Powyżej zera te same wartości pokazywane są jako zakresy, a pasmo na wykresie odpowiednio się poszerza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A zero, cada valor é um número único — a melhor estimativa da app. Acima de zero, os mesmos valores são apresentados como intervalos, e a banda no gráfico alarga em conformidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La zero, fiecare valoare este un singur număr — cea mai bună estimare a aplicației. Peste zero, aceleași valori sunt afișate ca intervale, iar banda de pe grafic se lărgește corespunzător."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri nule je každý údaj jediné číslo — najlepší odhad aplikácie. Nad nulou sa tie isté údaje zobrazujú ako rozpätia a pás v grafe sa tomu úmerne rozšíri."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pri ničli je vsaka številka ena sama vrednost — najboljša ocena aplikacije. Nad ničlo so iste številke prikazane kot razponi, temu primerno pa se razširi tudi pas na grafu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vid noll är varje siffra ett enda tal — appens bästa uppskattning. Över noll visas samma siffror som intervall, och bandet i diagrammet breddas på motsvarande sätt."
          }
        }
      }
    },
